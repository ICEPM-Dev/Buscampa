{
  "version": 2,
  "builds": [
    {
      "src": "backend/api/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "images": {
    "sizes": [320, 640, 768, 1024, 1280, 1536],
    "minimumCacheTTL": 3600,
    "formats": ["image/avif", "image/webp"]
  },
  "routes": [
    {
      "src": "/campamentos/(.*)",
      "dest": "backend/api/index.ts"
    },
    {
      "src": "/share/campamento/(.*)",
      "dest": "backend/api/index.ts"
    },
    { "src": "/robots.txt", "dest": "backend/api/index.ts" },
    { "src": "/sitemap.xml", "dest": "backend/api/index.ts" },
    {
      "src": "/api/auth/(google|facebook)/callback",
      "dest": "backend/api/index.ts"
    },
    { "src": "/favicon.svg", "dest": "frontend/favicon.svg" },
    {
      "src": "/api/(.*)",
      "dest": "backend/api/index.ts",
      "methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
    },
    { "src": "/auth/google/callback", "dest": "frontend/index.html" },
    { "src": "/auth/facebook/callback", "dest": "frontend/index.html" },
    { "src": "/assets/(.*)", "dest": "frontend/assets/$1" },
    { "src": "/c/(.*)", "dest": "backend/api/index.ts" },
    { "src": "/((?!api/).*)", "dest": "frontend/$1", "continue": true },
    { "src": "/(.*)", "dest": "frontend/index.html" }
  ]
}
